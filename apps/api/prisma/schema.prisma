// Database schema: the single source of truth for our tables.
// After editing, run `npm run db:migrate -w apps/api` to create a migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Models use PascalCase in code but map to snake_case tables and columns,
// which is the usual convention in Postgres.

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  // Never the password itself: a salted scrypt hash (see src/lib/password.ts)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships   WorkspaceMember[]
  assignedTasks Task[]
  sessions      Session[]

  @@map("users")
}

// One row per logged-in browser. Logging out deletes the row, which makes
// the cookie useless immediately, even if someone copied it.
model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  // SHA-256 of the token in the cookie, never the token itself
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Deleting a user logs them out everywhere
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  // Used in URLs, e.g. /acme. Unique so two workspaces can't share one.
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members WorkspaceMember[]
  boards  Board[]

  @@map("workspaces")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

// Join table for the many-to-many link between users and workspaces.
// It carries extra data (role), so it's an explicit model.
model WorkspaceMember {
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        Role     @default(MEMBER)
  joinedAt    DateTime @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Composite key: a user can join a workspace only once.
  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Board {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns   Column[]

  @@index([workspaceId])
  @@map("boards")
}

model Column {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  name      String
  // 0-based order of the column on its board
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId, position])
  @@map("columns")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  columnId    String    @map("column_id") @db.Uuid
  assigneeId  String?   @map("assignee_id") @db.Uuid
  title       String
  description String?
  priority    Priority  @default(MEDIUM)
  dueDate     DateTime? @map("due_date")
  // 0-based order of the task inside its column
  position    Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
  // If the assignee is deleted, keep the task but unassign it
  assignee User?  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([columnId, position])
  @@index([assigneeId])
  @@map("tasks")
}
